+func (h *dnsHandler) resolve(r *dns.Msg) *dns.Msg {
+	query, err := r.Pack()
+	if err != nil {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	raw, err := h.resolvePacket(ctx, query)
+	if err != nil {
+		return nil
+	}
+	answer := new(dns.Msg)
+	if err := answer.Unpack(raw); err != nil || !answer.Response || answer.Id != r.Id {
+		return nil
+	}
+	return answer
+}
